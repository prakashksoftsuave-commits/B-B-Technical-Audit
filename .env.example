# Copy to .env and fill in. .env is gitignored and must never be committed or pasted anywhere.
# The App Password is a 16-character string from https://myaccount.google.com/apppasswords
# Spaces in it are cosmetic - they are stripped, so either form works.

POC_IMAP_HOST=imap.gmail.com
POC_IMAP_PORT=993
POC_IMAP_USER=your-intake-mailbox@gmail.com
POC_IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional
POC_IMAP_FOLDER=INBOX
POC_IMAP_SINCE=01-Aug-2026
