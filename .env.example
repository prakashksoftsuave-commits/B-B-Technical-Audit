# Copy to .env and fill in. .env is gitignored and must never be committed or pasted anywhere.
# The App Password is a 16-character string from https://myaccount.google.com/apppasswords
# Spaces in it are cosmetic - they are stripped, so either form works.

POC_IMAP_HOST=imap.gmail.com
POC_IMAP_PORT=993
POC_IMAP_USER=your-intake-mailbox@gmail.com
POC_IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional
POC_IMAP_FOLDER=INBOX
POC_IMAP_SINCE=01-Aug-2026

# Reminder emails (POST /api/reminders/send) go out over SMTP from this same account -
# POC_IMAP_USER/POC_IMAP_PASSWORD above do double duty as the SMTP identity. Only set these if
# a different account should send than the one that receives.
# POC_SMTP_HOST=smtp.gmail.com
# POC_SMTP_PORT=465

# Rehearsal aid only - pins "today" for Pending/Overdue submission status so a live demo
# survives repeated Sync clicks. Remove this line to go back to the real date.
# POC_DEMO_AS_OF=2026-09-20
